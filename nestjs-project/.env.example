# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (MinIO — S3-compatible)
# S3_ENDPOINT is reached from inside the Docker network (Compose service name).
# S3_PUBLIC_ENDPOINT is used only to sign URLs consumed outside Docker: SigV4
# signs the Host header, so one value cannot serve both.
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube
S3_BUCKET=streamtube-videos

# Upload limits
UPLOAD_PART_SIZE_BYTES=10485760
UPLOAD_MAX_SIZE_BYTES=10737418240
UPLOAD_URL_TTL_SECONDS=3600
DELIVERY_URL_TTL_SECONDS=900
UPLOAD_ABORT_AFTER_DAYS=7

# Processing queue (BullMQ over Redis)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=streamtube
VIDEO_JOB_ATTEMPTS=3
VIDEO_JOB_BACKOFF_MS=2000
FFMPEG_TIMEOUT_MS=120000
